    "常规操作直接执行；删除数据、sudo、关机、改防火墙这类危险操作仍会先问你。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routine actions run right away; risky ones like deleting data, sudo, shutting down or changing the firewall still ask first."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常規操作直接執行；刪除資料、sudo、關機、改防火牆這類危險操作仍會先問你。"
          }
        }
      }
    },
    "应用并重新连接" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply and Reconnect"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用並重新連線"
          }
        }
